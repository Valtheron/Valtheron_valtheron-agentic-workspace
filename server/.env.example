# Anthropic API Key (erforderlich) — https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...
# Port (optional, Default 3001)
PORT=3001
# Modell-Override (optional; Default: Opus/Sonnet je nach Agent-Kategorie)
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Auth (Schritt 4) ──
# JWT-Signaturschlüssel — für Produktion unbedingt setzen (langer Zufallswert)
JWT_SECRET=change-me-to-a-long-random-string
# Passwort des initial angelegten Admins (Default: valtheron2026)
ADMIN_PASSWORD=valtheron2026

# ── Entwicklung ──
# MOCK_LLM=1 streamt Antworten ohne echten API-Aufruf (Tests ohne Key/Kosten)
# MOCK_LLM=1
